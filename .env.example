# Porta do servidor (a maioria dos serviços de hospedagem define isso sozinha)
PORT=3000

# Ambiente: use "development" só para testar no seu computador sem HTTPS.
# Em produção (site publicado), sempre use "production".
NODE_ENV=development

# Segredo usado para assinar os cookies de sessão. TROQUE por um valor aleatório longo em produção.
# Gere um em: https://generate-secret.vercel.app/32
SESSION_SECRET=troque-este-valor-por-uma-string-aleatoria-bem-grande

# Senha do administrador (texto puro, usada apenas para gerar o hash no primeiro start).
# Depois do primeiro start, o sistema passa a usar o hash salvo no banco (tabela config)
# e esta variável pode até ser removida. Para trocar a senha depois, use:
#   npm run set-admin-password "NovaSenha123!"
ADMIN_PASSWORD=Ambipar@

# --- Banco de dados (Postgres) ---
# String de conexão do seu banco Postgres gratuito (recomendado: Supabase).
# No painel do Supabase: Project Settings → Database → Connection string → URI
# (use a versão "Connection pooling" se disponível, termina em ...pooler.supabase.com)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome-do-banco

# --- Armazenamento de fotos (Supabase Storage) ---
# No painel do Supabase: Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a "service_role key" (NÃO a anon/public key) — ela fica só no servidor, nunca é exposta ao navegador
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key
# Nome do bucket criado no Supabase Storage para guardar as fotos (crie um bucket PRIVADO com esse nome)
SUPABASE_BUCKET=fotos-treinamento
